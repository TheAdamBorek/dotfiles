theme = TokyoNight
window-padding-color = background
font-thicken = true
font-family = MesloLGS Nerd Font Mono
font-size = 14
quit-after-last-window-closed = true

# Split the two Option keys. Ghostty's unset default resolves to "alt" only for
# U.S. Standard / U.S. International; the active layout here is Polish Pro, so
# Option was producing unicode and no <a-*> binding ever reached nvim. "left"
# gives terminal programs a real Alt while right Option keeps typing the Polish
# diacritics (option-a -> a-ogonek, option-l -> l-stroke, ...).
# On the Kinesis the left Alt is the physical left Win key - see
# kinesis/layout1.txt, which maps [lwin]>[lalt].
macos-option-as-alt = left

# tmux owns splits inside Ghostty, so free up cmd+d instead of opening a
# Ghostty split on top of the tmux panes.
keybind = super+d=unbind

# Omarchy only: its universal copy/paste (Super+C / Super+V) sends Ctrl+Insert /
# Shift+Insert to terminals. Ghostty's Linux default maps Shift+Insert to the
# primary selection, so without these Super+V pasted the last highlighted text
# instead of the clipboard. Harmless on macOS, where Cmd+C / Cmd+V stay as-is.
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
