#!/bin/sh
# Opens a new Ghostty window in the given directory (default: cwd) and starts
# nvim there. Backs the "Open in nvim" action in T3 Code; see README.
#
# `open -na Ghostty --args --working-directory=...` starts the shell in ~ and
# `open -a Ghostty <dir>` adds a tab to an existing window, so this goes
# through Ghostty's AppleScript API (1.3+). nvim is sent as initial input
# rather than as the command, so quitting it leaves a shell in the directory.
dir=${1:-$PWD}
exec osascript - "$dir" <<'APPLESCRIPT'
on run argv
  tell application "Ghostty"
    set cfg to new surface configuration
    set initial working directory of cfg to item 1 of argv
    set initial input of cfg to "nvim" & linefeed
    new window with configuration cfg
    activate
  end tell
end run
APPLESCRIPT
