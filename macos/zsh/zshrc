# Path to your oh-my-zsh installation.
export ZSH=$HOME/.oh-my-zsh
# fzf needs to defined after vi-mode as otherwise <C-r> doesn't work
plugins=(git git-extras npm node web-search vi-mode fzf)
export KEYTIMEOUT=1

# Environment variables live in zsh/zshenv and PATH in zsh/zprofile.
# HOMEBREW_PREFIX is exported by `brew shellenv` in zprofile.
if [[ -n "$HOMEBREW_PREFIX" ]]; then
  ZSH_AUTOSUGGESTIONS="$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  ZSH_SYNTAX_HIGHLIGHTING="$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

function clipboard_copy() { pbcopy; }

function sysreport() {
  echo "=== System ==="
  top -l 1 -n 0 | grep -E "Load Avg|CPU usage|PhysMem"
  echo "\n=== Top CPU ==="
  ps -Ao pid,%cpu,%mem,comm -r | head -8
  echo "\n=== Top Memory ==="
  ps -Ao pid,%cpu,%mem,comm -m | head -8
}

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Load the global defaults and project-specific tool versions from mise.
command -v mise >/dev/null && eval "$(mise activate zsh)"

source $ZSH/oh-my-zsh.sh
source ~/dotfiles/macos/zsh/aliases
source ~/dotfiles/macos/zsh/git_aliases

## Requires installing https://github.com/zsh-users/zsh-autosuggestions/tree/master
[ -f "$ZSH_AUTOSUGGESTIONS" ] && source "$ZSH_AUTOSUGGESTIONS"
[ -f "$ZSH_SYNTAX_HIGHLIGHTING" ] && source "$ZSH_SYNTAX_HIGHLIGHTING"

# Setup yazi & dependencies
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
# Worktree-aware `z`: zoxide ranks the main checkout highest, so a match inside
# another worktree of the current repo is remapped onto the current worktree.
function z() {
  local here
  here=$(git rev-parse --show-toplevel 2>/dev/null)
  if [[ -z $here || $# -eq 0 || ( $# -eq 1 && ( $1 == - || -d $1 ) ) ]]; then
    __zoxide_z "$@"
    return
  fi
  local target owner wt
  target=$(zoxide query --exclude "$(__zoxide_pwd)" -- "$@") || return
  # Longest prefix wins, in case a worktree lives inside the main checkout.
  for wt in ${(f)"$(git worktree list --porcelain | sed -n 's/^worktree //p')"}; do
    [[ ( $target == $wt || $target == $wt/* ) && ${#wt} -gt ${#owner} ]] && owner=$wt
  done
  if [[ -n $owner && $owner != $here && -d $here${target#$owner} ]]; then
    target=$here${target#$owner}
  fi
  __zoxide_cd "$target"
}
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}  

# Enable starship shell prompt
command -v starship >/dev/null && eval "$(starship init zsh)"

### VIM MODE
bindkey -v
# Override the vi-yank widget to also copy to the system clipboard.
# clipboard_copy wraps pbcopy; it is defined near the top of this file.
function vi_yank_system_clipboard() {
  zle vi-yank
  print -n "$CUTBUFFER" | clipboard_copy
}
zle -N vi_yank_system_clipboard
# Bind the widget to 'y' in vi command mode (vicmd keymap).
bindkey -M vicmd 'y' vi_yank_system_clipboard
### END OF VIM MODE

# Safe-chain from Aikido
# Before using safe-chain you may need to unsource this and install safe-chain first.
# npm install -g @aikidosec/safe-chain
[ -f ~/.safe-chain/scripts/init-posix.sh ] && source ~/.safe-chain/scripts/init-posix.sh
