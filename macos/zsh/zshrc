# macOS-only shell config. Linux is not on zsh, so this file no longer branches
# on `uname` -- the macOS-specific setup is inline below.

#Those exports fixes Python for installing xmlformatter in Mason (nvim)
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"

# # Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# # Initialization code that may require console input (password prompts, [y/n]
# # confirmations, etc.) must go above this block; everything else may go below.
# if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
#   source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
# fi

# Path to your oh-my-zsh installation.
export ZSH=$HOME/.oh-my-zsh
# fzf needs to defined after vi-mode as otherwise <C-r> doesn't work
plugins=(git git-extras npm node web-search vi-mode fzf)
export KEYTIMEOUT=1

export PATH="$HOME/.local/bin:$PATH"

# Homebrew is installed outside the default macOS PATH. Support both Apple
# Silicon and Intel prefixes without relying on a machine-local startup file.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# macOS setup: PATH additions, clipboard, plugin locations, sysreport.
# Must run before oh-my-zsh so PATH is complete by the time plugins load.
if command -v brew >/dev/null; then
  BREW_PREFIX="$(brew --prefix)"
  # GNU coreutils under their unprefixed names (gls, gsed... -> ls, sed...)
  export PATH="$PATH:$BREW_PREFIX/opt/coreutils/libexec/gnubin"

  ZSH_AUTOSUGGESTIONS="$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  ZSH_SYNTAX_HIGHLIGHTING="$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

function clipboard_copy() { pbcopy; }

function sysreport() {
  echo "=== System ==="
  top -l 1 -n 0 | grep -E "Load Avg|CPU usage|PhysMem"
  echo "\n=== Top CPU ==="
  ps -Ao pid,%cpu,%mem,comm -r | head -8
  echo "\n=== Top Memory ==="
  ps -Ao pid,%cpu,%mem,comm -m | head -8
}

# lazygit defaults to ~/Library/Application Support on macOS; use the XDG path
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Load the global defaults and project-specific tool versions from mise.
command -v mise >/dev/null && eval "$(mise activate zsh)"

source $ZSH/oh-my-zsh.sh
# Device-specific zsh settings are not tracked in dotfiles.
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
source ~/dotfiles/macos/zsh/aliases
source ~/dotfiles/macos/zsh/git_aliases

## Requires installing https://github.com/zsh-users/zsh-autosuggestions/tree/master
[ -f "$ZSH_AUTOSUGGESTIONS" ] && source "$ZSH_AUTOSUGGESTIONS"
[ -f "$ZSH_SYNTAX_HIGHLIGHTING" ] && source "$ZSH_SYNTAX_HIGHLIGHTING"

# Setup yazi & dependencies
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}  

# Enable starship shell prompt
command -v starship >/dev/null && eval "$(starship init zsh)"

### VIM MODE
bindkey -v
# Override the vi-yank widget to also copy to the system clipboard.
# clipboard_copy wraps pbcopy; it is defined near the top of this file.
function vi_yank_system_clipboard() {
  zle vi-yank
  print -n "$CUTBUFFER" | clipboard_copy
}
zle -N vi_yank_system_clipboard
# Bind the widget to 'y' in vi command mode (vicmd keymap).
bindkey -M vicmd 'y' vi_yank_system_clipboard
### END OF VIM MODE

# Safe-chain from Aikido
# Before using safe-chain you may need to unsource this and install safe-chain first.
# npm install -g @aikidosec/safe-chain
[ -f ~/.safe-chain/scripts/init-posix.sh ] && source ~/.safe-chain/scripts/init-posix.sh

export EDITOR='nvim'
