# Tracked environment variables for every zsh, including scripts and
# non-interactive shells. Sourced from ~/.zshenv, which stays a local file so
# each machine can add its own secrets there. Keep this file fast and silent:
# no output, no subprocesses, no PATH changes (macOS path_helper reorders PATH
# after this file runs, so PATH belongs in zprofile).

#Those exports fixes Python for installing xmlformatter in Mason (nvim)
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"

export EDITOR='nvim'

# lazygit defaults to ~/Library/Application Support on macOS; use the XDG path
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"

# pnpm global bin (pnpm 11+)
export PNPM_HOME="${PNPM_HOME:-$HOME/Library/pnpm}"
