# Tracked login shell setup: PATH and anything else that should run once per
# session and be inherited by child processes. Sourced from ~/.zprofile, which
# stays a local file because installers (Docker Desktop and others) append to it.

# Keep PATH free of duplicates when shells are nested.
typeset -U path PATH

# Homebrew is installed outside the default macOS PATH. Support both Apple
# Silicon and Intel prefixes without relying on a machine-local startup file.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# GNU coreutils under their unprefixed names (gls, gsed... -> ls, sed...)
[[ -n "$HOMEBREW_PREFIX" ]] && path+=("$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin")

path=("$HOME/.local/bin" "$PNPM_HOME/bin" $path)
